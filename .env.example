# =====================================================================
#  LILLE IN LOVE — variables d'environnement (MODÈLE)
#
#  ⚠  Ce fichier est versionné et part sur GitHub : n'y mets JAMAIS de
#     vraie clé. Les vraies clés vont dans .env.local, exclu par
#     .gitignore. GitHub refuse tout envoi contenant une clé.
#
#  Pour démarrer :  cp .env.example .env.local  puis remplis .env.local.
#  En production, saisis les mêmes valeurs chez ton hébergeur.
#
#      cp .env.example .env.local
#
#  Pour éprouver l'application sans aucune clé réelle : npm run test:curation
# =====================================================================

# --- Supabase --------------------------------------------------------
# Tableau de bord Supabase > ton projet > Settings > API
#   « Project URL »         → SUPABASE_URL
#   « service_role secret » → SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Cette clé contourne toutes les règles d'accès : uniquement côté serveur,
# jamais préfixée NEXT_PUBLIC_, jamais collée dans WordPress.
SUPABASE_SERVICE_ROLE_KEY=

# Nom du bucket photos (créé par supabase/02_storage.sql)
SUPABASE_STORAGE_BUCKET=lil-photos

# --- Resend ----------------------------------------------------------
# resend.com > API Keys > Create API Key (permission « Sending access »)
RESEND_API_KEY=

# L'expéditeur doit appartenir à un domaine vérifié chez Resend.
# in-love.fr est vérifié : l'expéditeur et l'adresse de réponse en viennent.
EMAIL_FROM="Lille in Love <info@in-love.fr>"
EMAIL_REPLY_TO=info@in-love.fr

# --- Sécurité --------------------------------------------------------
# Sel du hachage d'IP. Génère-le une fois :  openssl rand -hex 32
# Sans lui, aucune trace d'IP n'est conservée (le formulaire marche quand même).
IP_HASH_SALT=

# Pages autorisées à afficher le formulaire dans une iframe, séparées par
# des virgules. Tout autre site se verra refuser l'affichage.
ALLOWED_EMBED_ORIGINS=https://in-love.fr,https://www.in-love.fr

# Code d'accès au back-office /admin.
# VIDE = ACCÈS LIBRE : toute personne connaissant l'adresse voit les noms,
# les emails et les photos des candidats. Renseigne-le pour fermer l'accès.
ADMIN_CODE=

# Jeton pour consulter /api/emails/preview en production (facultatif).
# Sans jeton, cette page reste fermée hors développement.
EMAIL_PREVIEW_TOKEN=

# --- Curation --------------------------------------------------------
# Nombre de voix « oui » qui valident une candidature.
# 1 pour tester seul, 2 pour la règle des deux curateurs.
VOTES_REQUIS=1

# Délai entre une décision (validation, refus, tranche d'âge) et l'envoi de
# la réponse, en minutes. 360 = 6 h. Mets 2 le temps de tes essais.
DELAI_REPONSE_MINUTES=2

# --- Limitation d'abus (valeurs par défaut si absentes) ---------------
MAX_INSCRIPTIONS_PAR_HEURE=5
MAX_PHOTOS_PAR_10MIN=30

# --- Divers ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://in-love.fr

